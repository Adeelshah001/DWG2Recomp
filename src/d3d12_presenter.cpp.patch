 Presenter::PaintResult D3D12Presenter::PaintAndPresentImpl(bool execute_ui_drawers) {
+  // This path owns the paint context. Limit presentation only; never alter guest time.
+  struct ScopedTimerResolution {
+    bool active = false;
+    void Set(bool enable) {
+      if (enable == active) return;
+      if (enable) active = (timeBeginPeriod(1) == TIMERR_NOERROR);
+      else { timeEndPeriod(1); active = false; }
+    }
+    ~ScopedTimerResolution() { Set(false); }
+  };
+  static ScopedTimerResolution timer_res;
+  static auto next_present = std::chrono::steady_clock::now();
+  static int prior_cap = -1;
+  if (!dwg2::video::present_fps_initialized.load()) {
+    const int initial = dwg2::video::NormalizeFps(REXCVAR_GET(dwg2_present_fps));
+    int expected = dwg2::video::kDefaultFps;
+    dwg2::video::present_fps.compare_exchange_strong(expected, initial);
+    dwg2::video::present_fps_initialized.store(true);
+  }
+  const int cap = dwg2::video::present_fps.load();
+  const int pacing_cap = dwg2::video::HostPacingFps(cap, dwg2::video::battle_paced.load());
+  timer_res.Set(pacing_cap > 0);
+  auto now = std::chrono::steady_clock::now();
+  if (pacing_cap > 0) {
+    const auto interval = std::chrono::duration_cast<std::chrono::steady_clock::duration>(
+        std::chrono::duration<double>(1.0 / pacing_cap));
+    if (pacing_cap != prior_cap || now > next_present + interval) next_present = now;
+    if (next_present > now) {
+      constexpr auto kSpinWindow = std::chrono::milliseconds(2);
+      if (next_present - now > kSpinWindow) {
+        std::this_thread::sleep_until(next_present - kSpinWindow);
+      }
+      while (std::chrono::steady_clock::now() < next_present) {
+        YieldProcessor();
+      }
+    }
+    next_present += interval;
+  } else {
+    next_present = now;
+  }
+  prior_cap = pacing_cap;
