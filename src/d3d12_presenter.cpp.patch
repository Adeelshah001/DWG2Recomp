 Presenter::PaintResult D3D12Presenter::PaintAndPresentImpl(bool execute_ui_drawers) {
+  // This path owns the paint context. Limit presentation only; never alter guest time.
+  static auto next_present = std::chrono::steady_clock::now();
+  static int prior_cap = -1;
+  const int cap = REXCVAR_GET(dwg2_present_fps);
+  auto now = std::chrono::steady_clock::now();
+  if (cap > 0) {
+    const auto interval = std::chrono::duration_cast<std::chrono::steady_clock::duration>(std::chrono::duration<double>(1.0 / cap));
+    if (cap != prior_cap || now > next_present + interval) next_present = now;
+    if (next_present > now) std::this_thread::sleep_until(next_present);
+    next_present += interval;
+  } else { next_present = now; }
+  prior_cap = cap;
+
   // Begin the command list with the command allocator not currently potentially
   // used on the GPU.
