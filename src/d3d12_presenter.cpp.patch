+  if (SUCCEEDED(present_result) && present_result != DXGI_STATUS_OCCLUDED)
+    dwg2_diag::presents.fetch_add(1, std::memory_order_relaxed);
+  static auto sample_start = std::chrono::steady_clock::now();
+  static unsigned long long last_swaps = 0, last_presents = 0;
+  const auto sample_now = std::chrono::steady_clock::now();
+  const double seconds = std::chrono::duration<double>(sample_now - sample_start).count();
+  if (seconds >= 5.0) {
+    const auto swaps = dwg2_diag::swaps.load(std::memory_order_relaxed);
+    const auto presents = dwg2_diag::presents.load(std::memory_order_relaxed);
+    const double sf = (swaps-last_swaps)/seconds, pf = (presents-last_presents)/seconds;
