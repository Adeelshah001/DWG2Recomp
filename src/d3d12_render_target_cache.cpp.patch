+bool D3D12RenderTargetCache::Dwg2MigrateSceneFrom(const D3D12RenderTargetCache& old) {
+  // Hardware sample layouts must agree; no reinterpretation of 2x as 4x.
+  if(msaa_2x_supported_!=old.msaa_2x_supported_)return false;
+  std::vector<Dwg2SceneCopy> copies;
+  if(!Dwg2PrepareSceneCopies(old,copies))return false;
+  for(auto& copy:copies) {
+    if(copy.source->key().is_depth) {
+      // Keep the original float32 depth if its guest representation agrees.
+      // Source and secondary host-depth source share the same old profile.
+      for(auto& range:copy.ranges)range.host_depth_source=copy.source;
+      RenderTarget* targets[1]={copy.destination};std::vector<Transfer> ranges[1];ranges[0]=std::move(copy.ranges);
+      PerformTransfersAndResolveClears(1,targets,ranges);
+    } else {
+      RenderTarget* targets[2]={nullptr,copy.destination};std::vector<Transfer> ranges[2];ranges[1]=std::move(copy.ranges);
+      PerformTransfersAndResolveClears(2,targets,ranges);
+    }
+    if(dwg2_transfer_failed_)return false;
+  }
+  // Caller commits only after GPU completion, while both resource graphs live.
+  return true;
+}
