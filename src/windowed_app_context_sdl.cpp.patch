+void SDLWindowedAppContext::PumpNativeLoop() {
+  if (!IsInUIThread()) return;
+  static thread_local bool pumping = false;
+  if (pumping) return;
+  pumping = true;
+  // Do not pump Windows recursively or forward menu-navigation keys to gameplay.
+  SDL_Event event;
+  for (int n=0;n<64 && !HasQuitFromUIThread();++n) {
+    if (SDL_PeepEvents(&event,1,SDL_GETEVENT,wakeup_event_type_,paint_event_type_)!=1) break;
+    if(event.type==paint_event_type_) {
+      if(auto* window=GetWindow(event.user.windowID))window->HandlePaintEvent();
+    } else ExecutePendingFunctionsFromUIThread();
+  }
+  pumping = false;
 }
 
