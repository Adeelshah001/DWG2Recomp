# Game content and locally generated artifacts must never enter Git.
# A checkout must never contain an ISO, default.xex, generated title code,
# compiled objects, caches, saves, logs or release archives.
*.iso
*.xex
*.xexp
*.elf
*.pdb
*.obj
*.pch
*.exe
*.dll
*.lib
*.a
*.o
*.zip
*_recomp.*
*_funcs.*
*_init.*
*_register.*
*shader*
toolchain.local.json
display.ini*
prompts.ini*
installed.txt
launch-preview.txt
launcher-error.txt
__pycache__/

# Per-user mappings and save folders remain local.
/controls.ini*
/saves/
/save-data/
/bin-backups/
/portable/
/developer/

# Local camera preferences
camera.ini*

# The personal project plan is maintained outside this checkout.
/TO-DO.md
/WISHLIST.md

# Local build outputs (created by scripts/build-local.py and prepare-portable-sdk.py)
/.local-build/
/bin/
/tools/
/cache/
/logs/
/user-data/
/.update-backup/
/game-data*/

# Portable preparation capsule (generated by assemble-portable.py)
/preparation/

# Editor / OS artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db